@keyframes hud-rise {
    from { transform: translateY(100%); }
    to { transform: translateY(0%); }
}
#card-panel.below-screen, #phone.below-screen {
    transform: translateY(100%);
}
#card-panel.entering, #phone.entering {
    animation: 0.34s cubic-out hud-rise;
}

body {
    color: #f4eee2;
    pointer-events: none;
}
#header {
    position: absolute;
    top: 18dp;
    left: 22dp;
}
#header h1 {
    margin-bottom: 2dp;
}
#attempts, #link-help, #spring-help {
    color: #c4c5c9;
    font-size: 14dp;
}
button {
    pointer-events: auto;
    background-color: #20242a;
    border: 1dp #77706a;
    border-radius: 5dp;
    color: #fcf2e0;
}
button:hover {
    background-color: #4b4134;
    border-color: #e4b36b;
}
#controls {
    position: absolute;
    bottom: 14dp;
    left: 35%;
    width: 30%;
    text-align: center;
}
#message {
    font-size: 15dp;
}
#card-panel {
    position: absolute;
    left: 0.3vw;
    bottom: 0;
    width: 46.3vh;
    height: 46.3vh;
    max-width: 34vw;
    max-height: 34vw;
    decorator: image("Cards/SPR_Keypad.png");
}
.card {
    position: absolute;
    width: 25.98%;
    height: 25.98%;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    decorator: image("Cards/SPR_Key.png");
}
.card.column-1 { left: 7.32%; }
.card.column-2 { left: 37.01%; }
.card.column-3 { left: 66.70%; }
.card.row-1 { top: 7.32%; }
.card.row-2 { top: 37.01%; }
.card.row-3 { top: 66.70%; }
.card:hover, .card:focus-visible {
    background-color: transparent;
    decorator: image("Cards/SPR_Key_Highlighted.png");
}
.card:active {
    transform: scale(0.96);
}
.card.hinted {
    decorator: image("Cards/SPR_Key_Tip_Normal.png");
}
.card.hinted:hover, .card.hinted:focus-visible {
    decorator: image("Cards/SPR_Key_Tip.png");
}
.card.off {
    pointer-events: none;
    focus: none;
    decorator: image("Cards/SPR_Key_Off.png");
}
.card-value {
    position: absolute;
    top: 26%;
    left: 0;
    right: 0;
    color: #f0f8ff;
    font-size: 3.6vh;
    font-weight: bold;
    text-align: center;
    pointer-events: none;
}
@keyframes hud-drop {
    from { transform: translateY(0%); }
    to { transform: translateY(100%); }
}
#card-panel.retracted {
    transform: translateY(100%);
    animation: 0.45s cubic-in hud-drop;
}
#result-dim {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-color: black;
    opacity: 0;
    pointer-events: none;
}
#result-dim.dimmed {
    opacity: 0.5;
    transition: opacity 0.35s quadratic-out;
}
.hidden {
    display: none;
}
