#title-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-color: #0b1212;
    decorator: image("Title/SPR_Door.png" cover);
    image-color: #454545;
    pointer-events: none;
}

#title-menu, #title-level-select {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}
#title-menu h1 {
    margin: 2.094vh 0 0;
    font-size: 2.177vh;
    color: #f7ead7;
    pointer-events: none;
}
#title-menu .phone-icon {
    top: 34%;
    height: 39%;
    color: white;
    font-family: Sony Sketch EF;
    font-weight: bold;
}
#title-menu .phone-glyph {
    top: 35%;
    width: 64%;
    height: 50%;
}
#title-play .phone-glyph {
    decorator: image("Phone/ico_next.png" contain);
}
#title-choose-level .phone-glyph {
    decorator: image("Phone/ico_info.png" contain);
}
#title-menu .title-exit-glyph {
    height: auto;
    font-size: 3.266vh;
    line-height: 1;
}
#title-exit:hover .title-exit-glyph, #title-exit:focus-visible .title-exit-glyph {
    color: #eb8929;
}
.title-icon-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10%;
    font-size: 1.068vh;
    pointer-events: none;
}

#title-level-select h2 {
    margin: 0.963vh 0 0.502vh;
    font-size: 1.591vh;
    color: #f7ead7;
}
.title-action {
    display: block;
    box-sizing: border-box;
    width: 82%;
    height: 2.198vh;
    margin: 0.209vh auto;
    padding: 0 0.586vh;
    font-family: Sony Sketch EF;
    font-weight: bold;
    font-size: 1.131vh;
    text-align: left;
    color: white;
    border: 1dp #646464;
    border-radius: 0.268vh;
    background-color: transparent;
    pointer-events: auto;
}
.title-action:hover, .title-action:focus-visible {
    border-color: #eb8929;
    background-color: transparent;
    color: #eb8929;
}
#title-back {
    text-align: center;
}
