body {
    background-color: #111b1a;
    color: #f4eee2;
}
#title-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: image("Title/SPR_Door.png" cover);
    opacity: 0.52;
    pointer-events: none;
}
#title-panel {
    position: absolute;
    left: 9%;
    top: 23%;
    width: 33%;
    padding: 3.2vh;
    box-sizing: border-box;
    background-color: #111a19ed;
    border: 1dp #615346;
}
#title-panel h1 {
    font-family: Sony Sketch EF;
    font-weight: bold;
    font-size: 5.1vh;
    color: #f7ead7;
    margin: 0 0 2.4vh;
}
#title-panel h2 {
    font-size: 2vh;
    font-weight: normal;
    margin: 0 0 1vh;
    color: #cdbdae;
}
.title-action {
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin: 0 0 0.7vh;
    padding: 1.05vh 1.25vh;
    font-size: 2vh;
    text-align: left;
    color: #f4eee2;
    border: 1dp #6e6255;
    background-color: #232d2b;
}
.title-action:hover, .title-action:focus-visible {
    border-color: #eb8929;
    background-color: #454032;
}
#title-play {
    border-color: #a8754d;
}
#title-error {
    margin: 0;
    color: #f0ab91;
}
.hidden {
    display: none;
}
