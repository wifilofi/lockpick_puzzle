body {
    background-color: #0b1212;
}
#title-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: image("Title/SPR_Door.png" cover);
    opacity: 0.25;
    pointer-events: none;
}

@keyframes title-phone-zoom {
    from { transform: translate(23vw, 28vh) scale(0.42); }
    to { transform: translate(0vw, 0vh) scale(1); }
}
#phone.title-phone {
    left: 50%;
    top: 0.2vh;
    right: auto;
    bottom: auto;
    width: 125vh;
    height: 266.25vh;
    margin-left: -62.5vh;
    transform-origin: 50% 20%;
    animation: 0.48s cubic-out title-phone-zoom;
}

#title-menu, #title-level-select {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}
#title-menu h1 {
    margin: 5vh 0 0;
    font-size: 5.2vh;
    color: #f7ead7;
    pointer-events: none;
}
#title-menu .phone-icon {
    top: 34%;
    height: 39%;
    color: white;
    font-family: Sony Sketch EF;
    font-weight: bold;
}
#title-menu .phone-glyph {
    top: 35%;
    width: 64%;
    height: 50%;
}
#title-play .phone-glyph {
    decorator: image("Phone/ico_next.png" contain);
}
#title-choose-level .phone-glyph {
    decorator: image("Phone/ico_info.png" contain);
}
#title-menu .title-exit-glyph {
    height: auto;
    font-size: 7.8vh;
    line-height: 1;
}
#title-exit:hover .title-exit-glyph, #title-exit:focus-visible .title-exit-glyph {
    color: #eb8929;
}
.title-icon-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10%;
    font-size: 2.55vh;
    pointer-events: none;
}

#title-level-select h2 {
    margin: 2.3vh 0 1.2vh;
    font-size: 3.8vh;
    color: #f7ead7;
}
.title-action {
    display: block;
    box-sizing: border-box;
    width: 82%;
    height: 5.25vh;
    margin: 0.5vh auto;
    padding: 0 1.4vh;
    font-family: Sony Sketch EF;
    font-weight: bold;
    font-size: 2.7vh;
    text-align: left;
    color: white;
    border: 1.5dp #646464;
    border-radius: 0.64vh;
    background-color: transparent;
    pointer-events: auto;
}
.title-action:hover, .title-action:focus-visible {
    border-color: #eb8929;
    background-color: transparent;
    color: #eb8929;
}
#title-back {
    text-align: center;
}
#title-error {
    position: absolute;
    left: 5%;
    bottom: 3%;
    width: 90%;
    margin: 0;
    font-size: 2.5vh;
    color: #ff5c48;
    pointer-events: none;
}
.hidden {
    display: none;
}
