#phone {
    /* The two original photographs share a hinge. The base extends below the stage. */
    position: absolute;
    right: 0.55vw;
    bottom: -19.25vh;
    width: 36.41vh;
    height: 77.56vh;
    pointer-events: none;
}
#phone-base, #phone-lid {
    position: absolute;
    left: 0;
    width: 100%;
}
#phone-base {
    top: 44.22%;
    height: 55.78%;
    decorator: image("Phone/SPR_LockPhone_Down.png");
}
#phone-lid {
    top: 0;
    height: 45.03%;
    decorator: image("Phone/SPR_LockPhone_Up.png");
}
#phone-screen {
    position: absolute;
    left: 29%;
    top: 8.6%;
    width: 40.69%;
    height: 23.16%;
    border-radius: 0.55vh;
    overflow: hidden;
    background-color: #101010;
    decorator: image("Phone/phone_bg.png");
    color: white;
    font-family: Sony Sketch EF;
    font-weight: bold;
    text-align: center;
}
#phone-glass {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: image("Phone/SPR_Phone_Dirt.png");
    opacity: 0.20;
    pointer-events: none;
}
#phone-label, #phone-select {
    position: absolute;
    left: 4%;
    width: 92%;
    margin: 0;
    white-space: nowrap;
    pointer-events: none;
}
#phone-label {
    top: 3.5%;
    font-size: 1.39vh;
}
#phone-select {
    top: 90%;
    font-size: 1.02vh;
}
.phone-icon {
    position: absolute;
    width: 30%;
    height: 24.74%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    border: 1.5dp transparent;
    border-radius: 0.56vh;
    background-color: transparent;
    pointer-events: auto;
}
.phone-col-1 { left: 5%; }
.phone-col-2 { left: 35%; }
.phone-col-3 { left: 65%; }
.phone-row-1 { top: 15.46%; }
.phone-row-2 { top: 40.20%; }
.phone-row-3 { top: 64.95%; }
.phone-icon:hover, .phone-icon:focus-visible {
    background-color: transparent;
    border-color: #eb8929;
}
.phone-icon:hover .phone-glyph, .phone-icon:focus-visible .phone-glyph {
    image-color: #eb8929;
    transform: scale(1.3);
}
.phone-icon.unavailable {
    focus: none;
}
.phone-icon.unavailable .phone-glyph {
    image-color: #646464;
}
.phone-icon.unavailable:hover {
    border-color: #646464;
}
.phone-icon.passive {
    pointer-events: none;
}
.phone-glyph {
    position: absolute;
    left: 14.58%;
    top: 14.58%;
    width: 70.84%;
    height: 70.84%;
    pointer-events: none;
}
#undo .phone-glyph { decorator: image("Phone/ico_undo.png" contain); }
#hint .phone-glyph { decorator: image("Phone/ico_hint.png" contain); }
#restart .phone-glyph { decorator: image("Phone/ico_restart.png" contain); }
#phone-random .phone-glyph { decorator: image("Phone/ico_random.png" contain); }
#phone-home .phone-glyph { decorator: image("Phone/ico_menu.png" contain); }
#phone-info .phone-glyph { decorator: image("Phone/ico_info.png" contain); }
#phone-previous .phone-glyph { decorator: image("Phone/ico_previous.png" contain); }
#next-level .phone-glyph { decorator: image("Phone/ico_next.png" contain); }
#phone-deaths .phone-glyph { decorator: image("Phone/ico_deaths.png" contain); }
