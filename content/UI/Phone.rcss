#phone {
    /* The two original photographs share a hinge. The base extends below the stage. */
    position: absolute;
    right: 0.55vw;
    bottom: -38.64vh;
    width: 45.51vh;
    height: 96.95vh;
    pointer-events: none;
}
#phone-base, #phone-lid {
    position: absolute;
    left: 0;
    width: 100%;
}
#phone-base {
    top: 44.22%;
    height: 55.78%;
    decorator: image("Phone/SPR_LockPhone_Down.png");
}
#phone-lid {
    top: 0;
    height: 45.03%;
    decorator: image("Phone/SPR_LockPhone_Up.png");
}
#phone-screen {
    position: absolute;
    left: 29%;
    top: 8.6%;
    width: 40.69%;
    height: 23.16%;
    border-radius: 0.69vh;
    overflow: hidden;
    background-color: #101010;
    decorator: image("Phone/phone_bg.png");
    color: white;
    font-family: Sony Sketch EF;
    font-weight: bold;
    text-align: center;
}
#phone-glass {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: image("Phone/SPR_Phone_Dirt.png");
    opacity: 0.20;
    pointer-events: none;
}
#phone-label, #phone-select {
    position: absolute;
    left: 4%;
    width: 92%;
    margin: 0;
    white-space: nowrap;
    pointer-events: none;
}
#phone-label {
    top: 3.5%;
    font-size: 1.74vh;
}
#phone-select {
    top: 90%;
    font-size: 1.28vh;
}
.phone-icon {
    position: absolute;
    width: 30%;
    height: 24.74%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    border: 1.5dp transparent;
    border-radius: 0.56vh;
    background-color: transparent;
    pointer-events: auto;
}
.phone-col-1 { left: 5%; }
.phone-col-2 { left: 35%; }
.phone-col-3 { left: 65%; }
.phone-row-1 { top: 22%; }
.phone-row-2 { top: 53%; }
.phone-icon:hover, .phone-icon:focus-visible {
    background-color: transparent;
    border-color: #eb8929;
}
.phone-icon:hover .phone-glyph, .phone-icon:focus-visible .phone-glyph {
    image-color: #eb8929;
    transform: translate(-50%, -50%) scale(1.3);
}
.phone-icon.unavailable {
    focus: none;
}
.phone-icon.unavailable .phone-glyph {
    image-color: #646464;
}
.phone-icon.unavailable:hover {
    border-color: #646464;
}
#next-level.unavailable {
    display: none;
}
.phone-glyph {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
}
/* Compensate for the different transparent margins in the four original sprites. */
#undo .phone-glyph {
    width: 90%;
    height: 90%;
    decorator: image("Phone/ico_undo.png" contain);
}
#hint .phone-glyph {
    width: 61%;
    height: 61%;
    decorator: image("Phone/ico_hint.png" contain);
}
#restart .phone-glyph {
    width: 78%;
    height: 78%;
    decorator: image("Phone/ico_restart.png" contain);
}
#next-level .phone-glyph {
    width: 76%;
    height: 76%;
    decorator: image("Phone/ico_next.png" contain);
}
