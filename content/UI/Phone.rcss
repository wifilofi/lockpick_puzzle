#phone-anchor {
    position: absolute;
    z-index: 2;
    right: -0.55vw;
    bottom: -53.18vh;
    width: 52.34vh;
    height: 111.49vh;
    pointer-events: none;
}
#phone-zoom {
    position: absolute;
    top: 0;
}
#phone, #phone-front, #phone-play, #phone-menu {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}
#phone-base, #phone-hinge, #phone-lid, #phone-back {
    position: absolute;
    left: 0;
    width: 100%;
}
#phone-base {
    top: 44.22%;
    height: 55.78%;
    decorator: image("Phone/SPR_LockPhone_Down.png");
}
#phone-hinge {
    top: 0;
    height: 45.03%;
    transform-origin: 50% 104%;
}
#phone-lid, #phone-back {
    top: 0;
    height: 100%;
}
#phone-lid {
    decorator: image("Phone/SPR_LockPhone_Up.png");
}
#phone-back {
    decorator: image("Phone/SPR_LockPhone_Back.png");
}
#phone-screen {
    position: absolute;
    left: 29%;
    top: 19.1%;
    width: 40.69%;
    height: 51.43%;
    border-radius: 0.79vh;
    background-color: #101010;
    decorator: image("Phone/phone_bg.png");
    color: white;
    font-family: Sony Sketch EF;
    font-weight: bold;
    text-align: center;
}
#phone-play, #phone-menu {
    z-index: 1;
}
#phone-anchor.switching button {
    pointer-events: none;
    focus: none;
}
#phone-glass {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: image("Phone/SPR_Phone_Dirt.png");
    opacity: 0.20;
    pointer-events: none;
}
#phone-label, #phone-select {
    position: absolute;
    left: 4%;
    width: 92%;
    margin: 0;
    white-space: nowrap;
    pointer-events: none;
}
#phone-label {
    top: 3.5%;
    font-size: 2.00vh;
}
#phone-select {
    top: 90%;
    font-size: 1.47vh;
}
.phone-icon {
    position: absolute;
    width: 30%;
    height: 24.74%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    border: 1.5dp transparent;
    border-radius: 0.64vh;
    background-color: transparent;
    pointer-events: auto;
}
.phone-col-1 { left: 5%; }
.phone-col-2 { left: 35%; }
.phone-col-3 { left: 65%; }
.phone-row-1 { top: 22%; }
.phone-row-2 { top: 53%; }
.phone-icon:hover, .phone-icon:focus-visible {
    background-color: transparent;
    border-color: #eb8929;
}
.phone-icon:hover .phone-glyph, .phone-icon:focus-visible .phone-glyph {
    image-color: #eb8929;
    transform: translate(-50%, -50%) scale(1.3);
}
.phone-icon.unavailable {
    focus: none;
    border-color: transparent;
}
.phone-icon.unavailable .phone-glyph {
    image-color: #646464;
    transform: translate(-50%, -50%);
}
#next-level.unavailable, #phone-home.unavailable {
    display: none;
}
.phone-glyph {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
}
/* Compensate for the different transparent margins in the four original sprites. */
#undo .phone-glyph {
    width: 90%;
    height: 90%;
    decorator: image("Phone/ico_undo.png" contain);
}
#hint .phone-glyph {
    width: 61%;
    height: 61%;
    decorator: image("Phone/ico_hint.png" contain);
}
#restart .phone-glyph {
    width: 78%;
    height: 78%;
    decorator: image("Phone/ico_restart.png" contain);
}
#phone-home .phone-glyph {
    width: 76%;
    height: 76%;
    decorator: image("Phone/ico_menu.png" contain);
}
#next-level .phone-glyph {
    width: 76%;
    height: 76%;
    decorator: image("Phone/ico_next.png" contain);
}

/* Two 0.09s flashes, each followed by a 0.12s pause. */
@keyframes phone-result-blink {
    from { opacity: 1; }
    21% { opacity: 1; }
    22% { opacity: 0; }
    49% { opacity: 0; }
    50% { opacity: 1; }
    71% { opacity: 1; }
    72% { opacity: 0; }
    to { opacity: 0; }
}
#phone-result-flash {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    border-radius: 0.79vh;
    background-color: #ebf5ff;
    opacity: 0;
    pointer-events: none;
}
#phone-result-flash.blinking {
    animation: 0.42s linear phone-result-blink;
}
#phone-screen.result-pending .phone-icon {
    pointer-events: none;
    focus: none;
}
.phone-result-action {
    display: none;
}
#phone-result-message {
    display: none;
    position: absolute;
    left: 9%;
    top: 8%;
    width: 82%;
    height: 52%;
    box-sizing: border-box;
    border: 1dp #aaaab0;
    border-radius: 0.6vh;
    background-color: #060608;
    pointer-events: none;
}
#phone-result-icon {
    position: absolute;
    left: 38%;
    top: 9%;
    width: 24%;
    height: 45%;
    decorator: image("Phone/ico_message.png" contain);
    pointer-events: none;
}
#phone-screen.result-visible #phone-result-message {
    display: block;
}
#phone-screen.result-visible #phone-label {
    top: 36%;
    font-size: 3.2vh;
    color: #ff5c48;
}
#phone-screen.result-visible.victory #phone-label {
    color: #96eb8c;
}
#phone-screen.result-visible #phone-select,
#phone-screen.result-visible #hint,
#phone-screen.result-visible #undo.unavailable {
    display: none;
}
#phone-screen.result-visible .phone-icon {
    top: 65%;
    height: 29%;
}
#phone-screen.result-visible .phone-glyph {
    top: 37%;
    height: 62%;
}
#phone-screen.result-visible .phone-result-action {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1%;
    color: white;
    font-size: 1.55vh;
    pointer-events: none;
}
#phone-screen.result-visible #undo,
#phone-screen.result-visible.victory #restart { left: 5%; }
#phone-screen.result-visible #restart,
#phone-screen.result-visible #next-level { left: 35%; }
#phone-screen.result-visible #phone-home { left: 65%; }
