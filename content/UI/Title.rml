<rml>
<head>
    <title>Lockpick Puzzle</title>
    <link type="text/rcss" href="engine/ui/base.rcss" />
    <link type="text/rcss" href="Phone.rcss" />
    <link type="text/rcss" href="Title.rcss" />
    <link type="text/rcss" href="ScreenTransition.rcss" />
</head>
<body>
    <div id="title-backdrop"></div>
    <div id="phone" class="title-phone">
        <div id="phone-base"></div>
        <div id="phone-lid"></div>
        <div id="phone-screen">
            <div id="title-menu">
                <h1>Lockpick Puzzle</h1>
                <button id="title-play" class="phone-icon phone-col-1">
                    <span class="phone-glyph"></span>
                    <span class="title-icon-label">Play</span>
                </button>
                <button id="title-choose-level" class="phone-icon phone-col-2">
                    <span class="phone-glyph"></span>
                    <span class="title-icon-label">Level Select</span>
                </button>
                <button id="title-exit" class="phone-icon phone-col-3">
                    <span class="phone-glyph title-exit-glyph">×</span>
                    <span class="title-icon-label">Exit</span>
                </button>
            </div>
            <div id="title-level-select" class="hidden">
                <h2>Choose a level</h2>
                <div id="title-level-list"></div>
                <button id="title-back" class="title-action">Back</button>
            </div>
            <p id="title-error"></p>
            <div id="phone-glass"></div>
        </div>
    </div>
    <div id="screen-fade"></div>
</body>
</rml>
